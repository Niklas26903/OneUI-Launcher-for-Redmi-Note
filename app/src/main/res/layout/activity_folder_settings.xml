<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F4">

    <!-- One UI Large Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:gravity="bottom"
        android:padding="20dp"
        android:background="#0F60FF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ordner-Einstellungen"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Closed Folder section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Geschlossener Zustand (Symbol)"
                android:textStyle="bold"
                android:textColor="#1D1D1F"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ordner-Größe (dp)"
                        android:textSize="13sp" />
                    <EditText
                        android:id="@+id/et_folder_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="64" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vorschau Gitter (z.B. 2x2, 3x3)"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <EditText
                        android:id="@+id/et_folder_mini_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="3x3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hintergrundfarbe (Hex)"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <EditText
                        android:id="@+id/et_folder_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transparenz (%)"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <SeekBar
                        android:id="@+id/sb_folder_transparency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="30" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Form"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <Spinner
                        android:id="@+id/sp_folder_shape"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rahmenfarbe (Hex)"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <EditText
                        android:id="@+id/et_folder_border_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="#E0E0E0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rahmenstärke (dp)"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <EditText
                        android:id="@+id/et_folder_border_width"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Opened Folder section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Geöffneter Zustand (Ansicht)"
                android:textStyle="bold"
                android:textColor="#1D1D1F"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Animationsstil"
                        android:textSize="13sp" />
                    <Spinner
                        android:id="@+id/sp_folder_anim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fenstergröße Breite (%)"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <SeekBar
                        android:id="@+id/sb_folder_width"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="85" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fenstergröße Höhe (%)"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <SeekBar
                        android:id="@+id/sb_folder_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="60" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hintergrund-Abdunklung (%)"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <SeekBar
                        android:id="@+id/sb_folder_dim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gittergröße im Ordner (z.B. 3x4, 4x4)"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <EditText
                        android:id="@+id/et_folder_open_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="3x3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Schriftart Ordnername"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <Spinner
                        android:id="@+id/sp_folder_font"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Schriftfarbe Ordnername"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />
                    <EditText
                        android:id="@+id/et_folder_text_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="#1D1D1F" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btn_save_folder_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Speichern"
                android:backgroundTint="#0F60FF"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
