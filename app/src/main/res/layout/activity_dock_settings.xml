<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F4">

    <!-- One UI Large Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:gravity="bottom"
        android:padding="20dp"
        android:background="#0F60FF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dock-Einstellungen"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anzahl der Symbole (1-9)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1D1D1F" />
                    <SeekBar
                        android:id="@+id/sb_dock_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="8"
                        android:progress="3"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/tv_dock_count_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 Symbole"
                        android:textSize="12sp"
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginVertical="16dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_dock_glass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Glas-Effekt Hintergrundleiste"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1D1D1F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hintergrundfarbe (Hex)"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp" />
                    <EditText
                        android:id="@+id/et_dock_bg_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="#22000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hintergrund-Transparenz (%)"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp" />
                    <SeekBar
                        android:id="@+id/sb_dock_transparency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abgerundete Ecken (dp)"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp" />
                    <EditText
                        android:id="@+id/et_dock_corner_radius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="16" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginVertical="16dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_dock_autohide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Automatische Ausblendung (im App-Drawer)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1D1D1F" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btn_save_dock_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Speichern"
                android:backgroundTint="#0F60FF"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
